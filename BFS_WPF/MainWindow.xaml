<Window x:Class="BFS_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BFS_WPF"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" Title="MainWindow" Height="650" Width="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="129*"/>
            <ColumnDefinition Width="421*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10 20">
            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <TextBlock Width="60" VerticalAlignment="Center">Mode:</TextBlock>
                <ComboBox Name="ModeCb" VerticalAlignment="Center" Width="150" SelectedItem="{Binding Mode}" ItemsSource="{Binding modes}"></ComboBox>
            </StackPanel>
            <Button Name="CheckBtn" Click="CheckBtn_Click" Height="30" Margin="0 0 0 10">Проверить путь</Button>
        </StackPanel>
        
        <UniformGrid Name="MainGrid" Rows="10" Columns="10" Width="600" Height="600" Grid.Column="1"/>
    </Grid>
</Window>
