<UserControl x:Class="BFS_WPF.CellControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BFS_WPF"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="100">
    <Grid>
        <Border Name="CellBorder" BorderThickness="1" BorderBrush="Black" Background="Transparent" MouseDown="CellBorder_MouseDown">
            <TextBlock FontSize="10" Name="TextTb"></TextBlock>
        </Border>
    </Grid>
</UserControl>
